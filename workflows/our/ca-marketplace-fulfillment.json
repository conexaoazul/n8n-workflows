    {
      "parameters": {
        "command": "python3 /docker/openclaw/.openclaw/workspace/scripts/dhy_mail.py -s \"Módulo Odoo {{$json.slug}}\" --md {{$json.install_md || '/tmp/ca-marketplace-install.md'}}"
      },
      "id": "fulfill-module",
      "name": "Zip módulo + install.sh + dhy-mail",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [560, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_API_URL + '/api/v1/workflows' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.workflow_json }}"
      },
      "id": "fulfill-workflow",
      "name": "n8n API import",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [560, 80]
    },
    {
      "parameters": {
        "command": "paperclip create_agent --template {{$json.slug}} && python3 /docker/openclaw/.openclaw/workspace/scripts/dhy_mail.py -s \"Agent {{$json.slug}}\" --md {{$json.config_md || '/tmp/ca-marketplace-agent.md'}}"
      },
      "id": "fulfill-agent",
      "name": "paperclip create_agent + dhy-mail",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [560, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHATWOOT_BASE_URL + '/api/v1/accounts/' + $env.CHATWOOT_ACCOUNT_ID + '/contacts' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"name\": $json.customer.name, \"email\": $json.customer.email, \"phone_number\": $json.customer.phone}"
      },
      "id": "chatwoot-contact",
      "name": "Chatwoot criar inbox/contato",
