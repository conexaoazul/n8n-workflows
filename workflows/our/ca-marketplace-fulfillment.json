    {
      "parameters": {
        "command": "skill-installer install {{$json.slug}} && python3 /docker/openclaw/.openclaw/workspace/scripts/dhy_mail.py -s \"Seu skill {{$json.slug}}\" --md {{$json.onboarding_md || '/tmp/ca-marketplace-onboarding.md'}}"
      },
      "id": "fulfill-skill",
